# On Air — environment template
#
# Copy to .env.local and fill in. Never commit .env.local.
# The app runs end to end with NO keys at all: leave DEMO_MODE on and the
# scoring pipeline returns a canned transcript and report instead of calling
# out to anything.

# ----------------------------------------------------------------- app mode
# "true" keeps every paid API stubbed. Set to "false" only once keys are set.
DEMO_MODE=true

# ----------------------------------------------------------------- supabase
# Auth, profiles, cohorts, sessions, reports.
#
# These two are the switch for Google sign-in: set them and identity is a real
# Google account, leave them blank and the app falls back to a local demo
# cookie so the whole flow still runs with no keys. There is no separate flag,
# because a flag can disagree with reality and this cannot.
#
# Setup, once, in the Supabase dashboard:
#   1. Authentication > Providers > Google: enable, paste the Google OAuth
#      client id and secret.
#   2. In Google Cloud Console, the authorised redirect URI is Supabase's
#      callback, NOT this app's:  https://<project>.supabase.co/auth/v1/callback
#   3. Authentication > URL Configuration > Redirect URLs: add
#      http://localhost:3000/auth/callback and the deployed equivalent.
#      Site URL must be the deployed origin, never localhost.
#   4. Run supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------ queue tokens
# Signs the token the matchmaker verifies before placing anyone in a pool.
# BOTH processes must share this value — the web app mints, the matchmaker
# verifies. Leave it blank and both fall back to a published development
# secret, which the matchmaker warns about loudly on boot.
#
# This is the line that makes minor/adult separation real: without a verified
# token a browser can assert its own age band. Set it before a single real
# person uses this.  openssl rand -base64 48
MATCHMAKER_JWT_SECRET=

# ------------------------------------------------------------- own services
# Matchmaker + WebRTC signaling (stage 3). Stateful WebSocket process —
# this cannot live on Vercel functions.
NEXT_PUBLIC_MATCHMAKER_URL=ws://localhost:4100
# Post-call scoring worker (stage 8).
SCORING_WORKER_URL=http://localhost:4200

# ----------------------------------------------------------------- webrtc
# STUN is free and unlimited. TURN is only needed for the ~15-25% of
# connections behind symmetric NAT.
NEXT_PUBLIC_STUN_URLS=stun:stun.cloudflare.com:3478
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Cloudflare TURN is UDP-only. School and office networks often allow only
# TCP/443, so a coturn box on 443 is the second ICE server.
COTURN_URL=
COTURN_USERNAME=
COTURN_CREDENTIAL=

# -------------------------------------------------------------------- audio
# Where the per-participant mic recordings land.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ------------------------------------------------------------------ scoring
# Deepgram is chosen over Whisper because filler_words=true preserves the
# hesitations that the fluency score is actually made of.
DEEPGRAM_API_KEY=
# Report generation.
ANTHROPIC_API_KEY=
# AI conversation partner used when the queue runs dry (stage 11).
GEMINI_API_KEY=
